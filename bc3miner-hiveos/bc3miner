#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR
readonly SM75_SM86_BINARY="${SCRIPT_DIR}/lib/sm75-sm86/bc3miner"
readonly SM75_SM86_SHA256="__SM75_SM86_SHA256__"
readonly RATE_DIR="${BC3MINER_RATE_DIR:-/var/log/miner/custom/bc3miner-hiveos/rates}"

die() {
    printf 'bc3miner-hiveos: %s\n' "$*" >&2
    exit 1
}

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

verify_payload() {
    local path="$1" expected="$2" actual
    [[ -x $path ]] || die "required solver is missing or not executable: $path"
    actual=$(sha256sum "$path" | awk '{print $1}')
    [[ $actual == "$expected" ]] || die "solver checksum mismatch: $path"
    if ! "$path" --help >/dev/null 2>&1; then
        die "solver cannot run on this HiveOS userspace: $path"
    fi
}

declare -a miner_args=()
list_gpu_plan=0
for arg in "$@"; do
    case "$arg" in
        --list-gpu-plan) list_gpu_plan=1 ;;
        --backend|--backend=*|--device|--device=*)
            die '--backend and --device are selected per GPU by this launcher'
            ;;
        *) miner_args+=("$arg") ;;
    esac
done

command -v nvidia-smi >/dev/null 2>&1 || die 'nvidia-smi is required'
command -v sha256sum >/dev/null 2>&1 || die 'sha256sum is required'

verify_payload "$SM75_SM86_BINARY" "$SM75_SM86_SHA256"

driver_version=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader \
    | sed -n '1p') || die 'could not query the NVIDIA driver'
driver_version=$(trim "$driver_version")
driver_major=${driver_version%%.*}
case "$driver_major" in
    ''|*[!0-9]*) die "could not parse NVIDIA driver version: $driver_version" ;;
esac
[[ $driver_major -ge 580 ]] ||
    die "NVIDIA driver 580 or newer is required (found $driver_version)"

gpu_csv=$(nvidia-smi --query-gpu=index,uuid,name,compute_cap \
    --format=csv,noheader,nounits) || die 'could not inventory NVIDIA GPUs'
[[ -n $gpu_csv ]] || die 'no NVIDIA GPUs were detected'

declare -a inventory=()
declare -A seen_indices=() seen_uuids=()
while IFS=',' read -r raw_index raw_uuid raw_name raw_cc; do
    index=$(trim "$raw_index")
    uuid=$(trim "$raw_uuid")
    name=$(trim "$raw_name")
    cc=$(trim "$raw_cc")
    case "$index" in ''|*[!0-9]*) die "invalid GPU index: $index" ;; esac
    case "$uuid" in GPU-*) ;; *) die "invalid GPU UUID for device $index" ;; esac
    [[ -n $name && $name != *'|'* ]] || die "invalid GPU name for device $index"
    [[ -z ${seen_indices[$index]:-} ]] || die "duplicate GPU index: $index"
    [[ -z ${seen_uuids[$uuid]:-} ]] || die "duplicate GPU UUID: $uuid"
    seen_indices[$index]=1
    seen_uuids[$uuid]=1
    case "$cc" in
        7.5) inventory+=("$index|$uuid|$name|sm_75|legacy|$SM75_SM86_BINARY|legacy") ;;
        8.6) inventory+=("$index|$uuid|$name|sm_86|legacy|$SM75_SM86_BINARY|legacy") ;;
        *) die "GPU $index has unsupported compute capability $cc; supported: 7.5, 8.6" ;;
    esac
done <<< "$gpu_csv"
[[ ${#inventory[@]} -gt 0 ]] || die 'no supported NVIDIA GPUs were detected'

if [[ $list_gpu_plan -eq 1 ]]; then
    for entry in "${inventory[@]}"; do
        IFS='|' read -r index uuid name arch solver binary backend <<< "$entry"
        printf 'GPU %s uuid=%s name=%s arch=%s solver=%s backend=%s payload=%s\n' \
            "$index" "$uuid" "$name" "$arch" "$solver" "$backend" "$binary"
    done
    exit 0
fi

umask 022
mkdir -p "$RATE_DIR"
rm -f -- "$RATE_DIR"/gpu*.rate "$RATE_DIR"/.gpu*.pipe.* "$RATE_DIR"/.gpu*.rate.*
start_tmp=$(mktemp "${RATE_DIR}/.started_at.XXXXXX")
date +%s > "$start_tmp"
chmod 0644 "$start_tmp"
mv -f -- "$start_tmp" "$RATE_DIR/started_at"

run_gpu() (
    set +e
    local index="$1" uuid="$2" name="$3" arch="$4" solver="$5" binary="$6" backend="$7"
    shift 7
    local fifo miner_pid='' router_pid='' rc=1 rate_file tmp tagged line
    rate_file="${RATE_DIR}/gpu${index}.rate"
    fifo=$(mktemp "${RATE_DIR}/.gpu${index}.pipe.XXXXXX") || exit 1
    rm -f -- "$fifo"
    mkfifo -m 600 "$fifo" || exit 1

    cleanup() {
        trap - TERM INT HUP
        [[ -z $miner_pid ]] || kill -TERM "$miner_pid" 2>/dev/null || true
        [[ -z $router_pid ]] || kill -TERM "$router_pid" 2>/dev/null || true
        [[ -z $miner_pid ]] || wait "$miner_pid" 2>/dev/null || true
        [[ -z $router_pid ]] || wait "$router_pid" 2>/dev/null || true
        rm -f -- "$fifo"
    }
    trap 'cleanup; exit 143' TERM INT HUP

    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        tagged="[gpu${index}][${solver}] ${line}"
        printf '%s\n' "$tagged"
        if [[ $line == *'[speed]'* && $line == *' | A '*' R '* ]]; then
            tmp=$(mktemp "${RATE_DIR}/.gpu${index}.rate.XXXXXX") || continue
            if printf '%s\n' "$tagged" > "$tmp"; then
                chmod 0644 "$tmp"
                mv -f -- "$tmp" "$rate_file"
            else
                rm -f -- "$tmp"
            fi
        fi
    done < "$fifo" &
    router_pid=$!

    if command -v stdbuf >/dev/null 2>&1; then
        CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES="$uuid" \
            stdbuf -oL -eL "$binary" "$@" --device 0 --backend "$backend" \
            > "$fifo" 2>&1 &
    else
        CUDA_DEVICE_ORDER=PCI_BUS_ID CUDA_VISIBLE_DEVICES="$uuid" \
            "$binary" "$@" --device 0 --backend "$backend" \
            > "$fifo" 2>&1 &
    fi
    miner_pid=$!
    wait "$miner_pid"
    rc=$?
    wait "$router_pid" 2>/dev/null || true
    rm -f -- "$fifo"
    exit "$rc"
)

declare -a children=()
stop_all() {
    trap - TERM INT HUP
    local pid
    for pid in "${children[@]}"; do
        kill -TERM "$pid" 2>/dev/null || true
    done
    for pid in "${children[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
}
trap 'stop_all; exit 143' TERM INT HUP

for entry in "${inventory[@]}"; do
    IFS='|' read -r index uuid name arch solver binary backend <<< "$entry"
    printf 'bc3miner-hiveos: GPU %s (%s) -> %s solver=%s backend=%s uuid=%s\n' \
        "$index" "$name" "$arch" "$solver" "$backend" "$uuid"
    run_gpu "$index" "$uuid" "$name" "$arch" "$solver" "$binary" "$backend" \
        "${miner_args[@]}" &
    children+=("$!")
done

set +e
wait -n "${children[@]}"
rc=$?
set -e
stop_all
exit "$rc"
